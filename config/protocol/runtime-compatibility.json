  "data_contracts": [
    {
      "id": "cartridgeflow.capability.settings",
      "version": "1.0.0",
      "definition_kind": "json_schema",
      "definition": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://cartridgeflow.local/schemas/cartridge-settings.v1.schema.json",
        "title": "CartridgeFlow Cartridge Settings Contract v1",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "storage_scope",
          "fields"
        ],
        "properties": {
          "schema": {
            "const": "cartridgeflow.cartridge_settings.v1"
          },
          "storage_scope": {
            "const": "cartridge"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label",
                "type"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "string",
                    "number",
                    "integer",
                    "boolean",
                    "enum",
                    "file",
                    "object",
                    "array"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "sensitive": {
                  "type": "boolean"
                },
                "requires_restart": {
                  "type": "boolean"
                },
                "default": {},
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "value",
                      "label"
                    ],
                    "properties": {
                      "value": {
                        "type": [
                          "string",
                          "number"
                        ]
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                "validation": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "minimum": {
                      "type": "number"
                    },
                    "maximum": {
                      "type": "number"
                    },
                    "min_length": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "max_length": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "pattern": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "examples": {
        "invalid": {
          "schema": "cartridgeflow.cartridge_settings.v1",
          "storage_scope": "cartridge",
          "fields": [
            {
              "id": "internal_prompt",
              "label": "系统提示词",
              "type": "string",
              "node_id": "generate_brief",
              "system_prompt": "不得出现在公开设置合同中"
            }
          ]
        },
        "valid": {
          "schema": "cartridgeflow.cartridge_settings.v1",
          "storage_scope": "cartridge",
          "fields": [
            {
              "id": "brief_length",
              "label": "简报长度",
              "description": "控制最终简报的详细程度。",
              "type": "enum",
              "default": "normal",
              "options": [
                {
                  "value": "short",
                  "label": "精简"
                },
                {
                  "value": "normal",
                  "label": "标准"
                },
                {
                  "value": "long",
                  "label": "详细"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "id": "cartridgeflow.capability.settings-binding",
      "version": "1.0.0",
      "definition_kind": "json_schema",
      "definition": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://cartridgeflow.local/schemas/cartridge-settings-bindings.v1.schema.json",
        "title": "CartridgeFlow Cartridge Settings Bindings v1",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "bindings"
        ],
        "properties": {
          "schema": {
            "const": "cartridgeflow.cartridge_settings_bindings.v1"
          },
          "bindings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "setting_id",
                "target"
              ],
              "properties": {
                "setting_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                },
                "target": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "node_id",
                    "param"
                  ],
                  "properties": {
                    "kind": {
                      "const": "process_param"
                    },
                    "node_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                    },
                    "param": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "examples": {
        "valid": {
          "schema": "cartridgeflow.cartridge_settings_bindings.v1",
          "bindings": [
            {
              "setting_id": "brief_length",
              "target": {
                "kind": "process_param",
                "node_id": "generate_brief",
                "param": "length"
              }
            }
          ]
        }
      }
    },
    {
      "id": "cartridgeflow.capability.ui",
      "version": "1.0.0",
      "definition_kind": "json_schema",
      "definition": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://cartridgeflow.local/schemas/cartridge-ui.v1.schema.json",
        "title": "CartridgeFlow Cartridge UI Contract v1",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "mode",
          "host_capabilities"
        ],
        "properties": {
          "schema": {
            "const": "cartridgeflow.cartridge_ui.v1"
          },
          "mode": {
            "enum": [
              "none",
              "passive",
              "sandboxed"
            ]
          },
          "component_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "host_capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "artifact.read",
                "run.create",
                "run.result.read",
                "run.status.read",
                "settings.read",
                "settings.write"
              ]
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "none"
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "component_id"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "mode": {
                  "enum": [
                    "passive",
                    "sandboxed"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "component_id"
              ]
            }
          }
        ]
      },
      "examples": {
        "valid": {
          "schema": "cartridgeflow.cartridge_ui.v1",
          "mode": "none",
          "host_capabilities": []
        }
      }
    },
    {
      "id": "cartridgeflow.host.compatibility",
