    {
      "id": "cartridgeflow.runtime.host-profile",
      "version": "1.0.0",
      "definition_kind": "machine_contract",
      "definition": {
        "schema": "cartridgeflow.host_runtime_profile.v1",
        "id": "CF-DRP",
        "version": "1.1",
        "compatible_target_versions": [
          "1.0",
          "1.1"
        ],
        "host_id": "cartridgeflow.desktop-runner",
        "release_envelopes": [
          {
            "id": "CF-CRE",
            "versions": [
              "1",
              "2"
            ]
          }
        ],
        "flow_protocols": [
          {
            "id": "CF-FARP",
            "versions": [
              "1.0",
              "1.1",
              "1.7"
            ]
          }
        ],
        "ui_modes": [
          "none",
          "passive"
        ],
        "state_types": [
          "control",
          "system",
          "terminal",
          "process"
        ],
        "process_actions": [
          "collect_inputs",
          "llm_prompt",
          "pass_result",
          "confirm_checkpoint",
          "tool_call",
          "render_interaction"
        ],
        "edge_kinds": [
          "sequence",
          "failure"
        ],
        "binding_sources": [
          "run_input",
          "store",
          "node_output",
          "constant"
        ],
        "tool_transports": [
          "cartridge_dlc",
          "mcp",
          "remote_api",
          "plugin"
        ],
        "model_wire_apis": [
          "chat_completions"
        ],
        "limits": {
          "max_sequence_out_degree": 1,
          "allow_cycles": false,
          "allow_parallel": false
        }
      }
    },
    {
      "id": "cartridgeflow.runtime.target",
      "version": "1.0.0",
      "definition_kind": "json_schema",
      "definition": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://cartridgeflow.local/protocol/runtime-profiles/dr/1.0/target.schema.json",
        "title": "CartridgeFlow runtime target declaration",
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            }
          }
        }
      }
    }
  ]
}
