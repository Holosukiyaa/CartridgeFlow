        "valid": {
          "schema": "cartridgeflow.host.compatibility.v1",
          "status": "compatible",
          "findings": []
        }
      }
    },
    {
      "id": "cartridgeflow.host.target",
      "version": "1.0.0",
      "definition_kind": "json_schema",
      "definition": {
        "type": "object",
        "required": [
