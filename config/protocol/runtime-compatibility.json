          }
        },
        "additionalProperties": false,
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:cartridgeflow.host.target:1.0.0",
        "title": "运行目标合同 1.0.0",
        "description": "声明发行物要求的运行协议、状态类型和能力限制。"
      },
      "examples": {
        "invalid": {},
        "valid": {
