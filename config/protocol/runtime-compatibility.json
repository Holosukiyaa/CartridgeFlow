        "additionalProperties": false,
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:cartridgeflow.host.compatibility:1.0.0",
        "title": "运行兼容性报告 1.0.0",
        "description": "记录 runtime target 与 host profile 的确定比较结论。"
      },
      "examples": {
