      "output": "video_render"
     }
    }
   },
   "outputs": {
    "approval": {
     "schema": {
      "type": "object"
     },
     "target": {
      "type": "store",
      "key": "approval"
     }
    }
   },
   "layout": {
    "x": 4394,
    "y": 1277
   }
  },
  "delivery_ready": {
   "type": "process",
   "kind": "delivery",
   "executor": "deterministic",
   "effect": "writes_store",
   "action": "collect_artifacts",
