  "collect_run_context": {
   "type": "process",
   "kind": "input",
   "executor": "user",
   "effect": "writes_store",
   "action": "collect_inputs",
   "title": "确认日报运行参数",
   "display_name": "确认日报运行参数",
   "params": {
