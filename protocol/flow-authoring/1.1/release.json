  ],
  "profiles_file": "flow-authoring/1.1/profiles.json",
  "capabilities_file": "flow-authoring/1.1/capabilities.json",
  "tool_packs_file": "base/0.3/tool_packs.json",
  "document": "protocol/flow-authoring/1.1/README.md"
