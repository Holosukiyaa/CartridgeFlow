{
  "name": "@cartridgeflow/intent-studio",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test:static": "node scripts/static-assert.mjs",
    "test:unit": "vitest run --environment jsdom",
    "test": "npm run typecheck && npm run test:static && npm run test:unit"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@mantine/core": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@mantine/notifications": "^9.5.1",
    "@xyflow/react": "^12.11.2",
    "allotment": "^1.20.5",
    "lucide-react": "^1.26.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^24.1.3",
    "typescript": "~6.0.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  }
}
